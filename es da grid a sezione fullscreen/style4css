.container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: 100px 100px;
  gap: 10px;

  justify-items: center;
  align-items: center;

  background-color: #eee;
  max-width: 600px;
  margin: 20px auto;
}

.cell {
  background-color: #4285f4;
  color: white;
  font-size: 1.5rem;
  border-radius: 5px;
  width: 80%;   /* dimensione minore per vedere bene il centramento */
  height: 60%;
  display: flex;
  justify-content: center;
  align-items: center;
}
